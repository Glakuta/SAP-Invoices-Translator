# PDF Generator Configuration
# Mode: local | b1sl | s4odata
PDF_GENERATOR_MODE=local
PDF_OUTPUT_DIR=output

# SAP B1 Service Layer Configuration (for b1sl mode)
SAP_B1_BASE_URL=https://your-b1-server:50000
SAP_B1_USERNAME=your-username
SAP_B1_PASSWORD=your-password
SAP_B1_COMPANY_DB=your-company-db
SAP_B1_REPORT_PATH=SalesInvoice.rpt

# SAP S/4HANA Configuration (for s4odata mode)
SAP_S4_BASE_URL=https://your-s4-server
SAP_S4_CLIENT_ID=your-client-id
SAP_S4_CLIENT_SECRET=your-client-secret
SAP_S4_OUTPUT_TEMPLATE=ZINV_01

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# SAP Type (B1 or S4HANA)
SAP_TYPE=B1
SAP_BASE_URL=https://your-sap-server
SAP_USERNAME=your-username
SAP_PASSWORD=your-password
SAP_CLIENT=your-client